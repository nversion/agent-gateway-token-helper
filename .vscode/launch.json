{
  // Debug agw-token against Google, Entra ID or the local fake IdP.
  // Each configuration keeps its config, cache and file-store tokens in
  // build/dev/<name> (AGW_HOME), separate from an installed agw-token.
  // The "command", "store" and "output" pickers are asked on launch. With store=auto,
  // macOS shows a Keychain "allow" prompt after each rebuild, because the
  // debug binary is unsigned.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "agw-token: fake IdP",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/agw-token",
      // Starts cmd/fake-oidc on 127.0.0.1:9999 in the background (tasks.json).
      "preLaunchTask": "fake-oidc",
      "console": "integratedTerminal",
      "env": {
        "AGW_HOME": "${workspaceFolder}/build/dev/fake"
      },
      "args": [
        "${input:command}",
        "--issuer", "http://127.0.0.1:9999",
        "--client-id", "agw-test-client",
        "--store", "${input:store}",
        "--output", "${input:output}",
        // The fake signs in without a login page, so the browser just shows
        // "Signed in". Add --no-browser to only print the URL.
        "--min-valid", "5m"
      ]
    },
    {
      "name": "agw-token: Google",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/agw-token",
      "console": "integratedTerminal",
      "env": {
        "AGW_HOME": "${workspaceFolder}/build/dev/google"
      },
      "args": [
        "${input:command}",
        "--provider", "google",
        "--store", "${input:store}",
        "--output", "${input:output}"
      ]
    },
    {
      "name": "agw-token: Entra ID",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/agw-token",
      "console": "integratedTerminal",
      "env": {
        "AGW_HOME": "${workspaceFolder}/build/dev/entra"
      },
      "args": [
        "${input:command}",
        "--provider", "entra",
        "--tenant", "${input:tenant}",
        "--store", "${input:store}",
        "--output", "${input:output}"
      ]
    },
    {
      // Debug the fake provider itself. Stop the "fake-oidc" task first if
      // it is running, since both use port 9999.
      "name": "fake-oidc",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/fake-oidc",
      "console": "integratedTerminal",
      "args": ["--addr", "127.0.0.1:9999", "--ttl", "10m", "--rotate-refresh-tokens"]
    }
  ],
  "inputs": [
    {
      "id": "output",
      "type": "pickString",
      "description": "Token output (decoded = header and payload as JSON)",
      "options": ["raw", "decoded", "json", "headers"],
      "default": "raw"
    },
    {
      "id": "command",
      "type": "pickString",
      "description": "agw-token command",
      "options": ["token", "login", "status", "logout"],
      "default": "token"
    },
    {
      "id": "store",
      "type": "pickString",
      "description": "Token store (auto = Keychain / DPAPI / Secret Service)",
      "options": ["file", "auto"],
      "default": "file"
    },
    {
      "id": "tenant",
      "type": "promptString",
      "description": "Entra tenant ID or domain (organizations = any work account)",
      "default": "organizations"
    }
  ]
}
